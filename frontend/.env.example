# ==============================================================================
# ClipForge AI - Frontend Environment Configuration
# ==============================================================================

# Backend API Base URL
# - In local development: leave empty to use the Vite proxy (/api -> http://127.0.0.1:8000)
# - When deploying on Vercel: YOU MUST SET THIS to your deployed Python backend URL!
#   Example: https://clipforge-backend.onrender.com
#
# IMPORTANT:
# Vercel only hosts static frontends and its Serverless body limit is 4.5MB.
# If VITE_API_BASE_URL is not set, Vercel will attempt to handle video uploads
# and will fail with infinite buffering or HTTP 413 Payload Too Large.
VITE_API_BASE_URL=https://clipforge-backend.onrender.com
