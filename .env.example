# ClipForge AI - Environment Configuration Example

# Server Port (Render automatically sets $PORT in production, default is 8000)
PORT=8000

# File Upload Limit in Megabytes (Backend supports large files, e.g. 500MB)
MAX_UPLOAD_SIZE_MB=500

# Automatic Temporary File Retention in Hours
RETENTION_HOURS=24

# Allowed Frontend Origins for CORS (comma-separated list, or * for all)
# Production example: https://ai-clip-seven.vercel.app,http://localhost:5173
CORS_ORIGINS=*

# Custom Persistent Storage Directory (Optional)
# If mounting a Render Persistent Disk at /var/data, set:
# DATA_DIR=/var/data

# Custom FFmpeg binary path (Leave empty to use system/bundled FFmpeg)
# FFMPEG_PATH=/usr/bin/ffmpeg

# Speech-to-text (Optional faster-whisper)
ENABLE_WHISPER=true
WHISPER_MODEL=tiny

# ==============================================================================
# Optional Decoupled Cloud Storage (AWS S3 / Cloudflare R2 / MinIO)
# When configured, frontend uploads large videos directly to S3 via pre-signed PUT URLs,
# completely bypassing Vercel's 4.5MB Serverless function payload limit.
# ==============================================================================
# AWS_S3_BUCKET_NAME=my-clipforge-bucket
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# AWS_SECRET_ACCESS_KEY=YYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com # Optional for Cloudflare R2
